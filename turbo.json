{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_BASE_API_URL",
    "NEXT_PUBLIC_DEBUG_MODE",
    "DATABASE_URL",
    "ELYSIA_PORT",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "NEXTAUTH_SESSION_EXPIRES_IN",
    "CORS_ORIGINS"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "storybook:build": {
      "dependsOn": ["^jest:test"],
      "outputs": ["storybook-static/**"]
    },
    "jest:test": {
      "dependsOn": ["^jest:test"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "prettier": {
      "dependsOn": ["^prettier"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "cpenv": {
      "dependsOn": ["^cpenv"]
    }
  }
}
