{
  "apps/next/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
    "bash -c 'cd apps/next && eslint --fix'",
    "bash -c 'cd apps/next && eslint --no-warn-ignored --max-warnings 0'",
    "prettier --write"
  ],
  "apps/elysia/**/*.{js,ts,mjs,cjs}": [
    "bash -c 'cd apps/elysia && eslint --fix'",
    "bash -c 'cd apps/elysia && eslint --no-warn-ignored --max-warnings 0'",
    "prettier --write"
  ],
  "packages/constants/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
    "bash -c 'cd packages/constants && eslint --fix'",
    "bash -c 'cd packages/constants && eslint --no-warn-ignored --max-warnings 0'",
    "prettier --write"
  ],
  "packages/eslint-config/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
    "bash -c 'cd packages/eslint-config && eslint --fix'",
    "bash -c 'cd packages/eslint-config && eslint --no-warn-ignored --max-warnings 0'",
    "prettier --write"
  ],
  "packages/utils/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
    "bash -c 'cd packages/utils && eslint --fix'",
    "bash -c 'cd packages/utils && eslint --no-warn-ignored --max-warnings 0'",
    "prettier --write"
  ],
  "*.{json,css}": ["prettier --write"]
}
