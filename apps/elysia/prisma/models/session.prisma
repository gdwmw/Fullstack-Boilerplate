model Sessions {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  jti            String    @unique
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id")
  rotatedFromJti String?   @map("rotated_from_jti")
  replacedByJti  String?   @map("replaced_by_jti")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime  @map("expires_at")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  user           Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([userId, expiresAt], map: "auth_sessions_user_id_expires_at_idx")
  @@index([familyId], map: "auth_sessions_family_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("sessions")
}
